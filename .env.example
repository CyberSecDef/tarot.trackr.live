# Copy to .env (gitignored). Only the key is required for Jev; without it,
# every reading uses the fallback classification.
TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
# TYPESAFE_MODEL=jev-latest
# READING_RATE_LIMIT=10

# Hard ceiling on Jev spend. Over it, readings still work, untailored.
# JEV_MONTHLY_BUDGET_USD=10
# JEV_DAILY_BUDGET_USD=1          # default: a tenth of the monthly cap
# JEV_PRICE_INPUT_PER_MTOK=0.042
# JEV_PRICE_OUTPUT_PER_MTOK=0
# TAROT_DATA_DIR=data             # holds the spend ledger; must survive deploys
